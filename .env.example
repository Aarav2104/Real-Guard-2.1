# Copy to backend/.env (never commit .env). Restart the server after editing.
# The LLM is used ONLY for the optional "Structure with LLM" policy step; Real Guard decisions never call it.

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# "openrouter/free" lets OpenRouter pick any currently-available free model. You can pin one instead, e.g. a model id ending in ":free"
# from https://openrouter.ai/models?pricing=free
OPENROUTER_MODEL=openrouter/free
# Optional: comma-separated fallbacks tried by OpenRouter if the first model is rate-limited or down
# OPENROUTER_FALLBACK_MODELS=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_NAME=Real Guard
# OPENROUTER_SITE_URL=

# Any other OpenAI-compatible provider: set LLM_PROVIDER=openai_compatible and fill these in
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

REALGUARD_PSEUDONYM_KEY=change-me-long-random-string
REALGUARD_HTTP_TIMEOUT=10
